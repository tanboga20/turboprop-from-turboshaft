# OS
.DS_Store
Thumbs.db

# MATLAB
*.asv
*.m~
*.autosave
*.mex*
slprj/

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# CAD lock, backup and temporary files
~$*
*.bak
*.FCStd1
*.tmp

# Generated results (the run scripts in calc/ and rotordynamics/ write here)
calc/results/
rotordynamics/results/

# Raw CATIA screen captures and drawing renders (cad/scripts/crop_img.py keeps the PNGs for the reports)
cad/img/*.jpg
cad/drawings/*.png

# Licensed standards (single-user copies) kept in the repo root on a PC must never be committed
/*.pdf

# STL exports and rendered frames of the report animations (cad/anim)
cad/anim/stl/
cad/anim/out/
